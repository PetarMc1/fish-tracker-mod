{
  "schemaVersion": 1,
  "id": "fishtracker",
  "version": "${version}",
  "name": "FishTracker",
  "description": "A mod that tracks your caught fish on CosmosMc and sends them to an API",
  "authors": ["Petar_mc"],
  "contact": {
    "homepage": "https://tracker.petarmc.com/mod",
    "issues": "https://github.com/PetarMc1/fish-tracker/issues"
  },
  "license": "MIT",
  "icon": "assets/fishtracker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.petarmc.fishtracker.FishtrackerClient"
    ],
    "modmenu": [
      "com.petarmc.fishtracker.integration.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "petarlib": ">=${lib_version}",
    "cloth-config": "${cloth_config_version}"
  },
  "suggests": {
    "modmenu": "${modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.website": "https://tracker.petarmc.com/mod",
        "modmenu.issues": "https://github.com/PetarMc1/fish-tracker/issues",
        "modmenu.source": "https://github.com/PetarMc1/fish-tracker"
      },
      "update_checker": true
    }
  }
}
